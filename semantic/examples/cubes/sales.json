{
  "kind": "cube",
  "name": "sales",
  "view": "sales",
  "description": "주문 매출. 월 요약으로 풀 수 있으면 요약 view 를 쓴다.",
  "dimensions": [
    {
      "name": "order_month",
      "type": "date",
      "column": "order_month",
      "default_filter": null,
      "encryption": false,
      "role": []
    },
    {
      "name": "order_year",
      "type": "date",
      "expression": "date_trunc('year', order_month)",
      "default_filter": null,
      "encryption": false,
      "role": []
    },
    {
      "name": "region_code",
      "type": "code",
      "column": "region_code",
      "default_filter": null,
      "encryption": false,
      "role": []
    },
    {
      "name": "status_code",
      "type": "code",
      "column": "status_code",
      "default_filter": null,
      "encryption": false,
      "role": []
    },
    {
      "name": "customer_id",
      "type": "string",
      "column": "customer_id",
      "default_filter": null,
      "encryption": false,
      "role": []
    }
  ],
  "facts": [
    {
      "name": "sale_amount",
      "column": "sale_amount",
      "amount": true,
      "fx": false,
      "default_filter": null,
      "encryption": false,
      "role": ["finance"]
    },
    {
      "name": "fx_rate",
      "column": "fx_rate",
      "amount": false,
      "fx": true,
      "default_filter": null,
      "encryption": false,
      "role": ["finance"]
    },
    {
      "name": "krw_amount",
      "expression": "sale_amount * fx_rate",
      "amount": true,
      "fx": false,
      "default_filter": null,
      "encryption": false,
      "role": ["finance"]
    }
  ]
}
