{
  "kind": "cube",
  "name": "sales",
  "view": "orders_customer",
  "description": "주문과 고객을 묶은 매출.",
  "dimensions": [
    {
      "name": "order_date",
      "type": "date",
      "column": "order_date",
      "default_filter": null,
      "encryption": false,
      "role": "all"
    },
    {
      "name": "order_year",
      "type": "date",
      "expression": "date_trunc('year', order_date)",
      "default_filter": null,
      "encryption": false,
      "role": "all"
    },
    {
      "name": "region_code",
      "type": "code",
      "column": "region_code",
      "default_filter": null,
      "encryption": false,
      "role": "all"
    },
    {
      "name": "status_code",
      "type": "code",
      "column": "status_code",
      "default_filter": null,
      "encryption": false,
      "role": "all"
    },
    {
      "name": "customer_id",
      "type": "string",
      "column": "customer_id",
      "default_filter": null,
      "encryption": false,
      "role": "all"
    }
  ],
  "facts": [
    {
      "name": "sale_amount",
      "column": "sale_amount",
      "amount": true,
      "fx": false,
      "default_filter": null,
      "encryption": false,
      "role": ["finance"]
    },
    {
      "name": "fx_rate",
      "column": "fx_rate",
      "amount": false,
      "fx": true,
      "default_filter": null,
      "encryption": false,
      "role": ["finance"]
    },
    {
      "name": "krw_amount",
      "expression": "sale_amount * fx_rate",
      "amount": true,
      "fx": false,
      "default_filter": null,
      "encryption": false,
      "role": ["finance"]
    }
  ]
}
