{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sql-mcp.local/semantic/table.schema.json",
  "title": "Table",
  "description": "DW에서 고른 물리 테이블. 코딩 에이전트가 tables/{name}.json 으로 등록한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "name",
    "db",
    "schema",
    "table",
    "columns",
    "pk",
    "fk",
    "permission_filters",
    "scope_filter",
    "default_filter"
  ],
  "properties": {
    "kind": { "const": "table" },
    "name": {
      "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name",
      "description": "논리 테이블 이름. view 가 이 이름으로 참조한다."
    },
    "description": { "type": "string" },
    "db": {
      "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name",
      "description": "물리 데이터베이스 이름."
    },
    "schema": {
      "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name",
      "description": "물리 스키마 이름."
    },
    "table": {
      "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name",
      "description": "물리 테이블 이름."
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/column" }
    },
    "pk": {
      "type": "array",
      "items": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" },
      "uniqueItems": true,
      "description": "기본키 컬럼. 없으면 빈 배열."
    },
    "fk": {
      "type": "array",
      "items": { "$ref": "#/$defs/foreignKey" }
    },
    "permission_filters": {
      "type": "array",
      "description": "역할별 행 권한 필터. 물리 컬럼을 쓴다.",
      "items": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/permissionFilter" }
    },
    "scope_filter": {
      "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/nullableFilter",
      "description": "조회 범위 필터. 물리 컬럼을 쓴다. 없으면 null."
    },
    "default_filter": {
      "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/nullableFilter",
      "description": "항상 붙는 기본 필터. 물리 컬럼을 쓴다. 없으면 null."
    }
  },
  "$defs": {
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "nullable"],
      "properties": {
        "name": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "DW 물리 타입 이름."
        },
        "nullable": { "type": "boolean" }
      }
    },
    "foreignKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "references"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" }
        },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "required": ["table", "columns"],
          "properties": {
            "table": {
              "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name",
              "description": "참조하는 논리 테이블 name."
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" }
            }
          }
        }
      }
    }
  }
}
