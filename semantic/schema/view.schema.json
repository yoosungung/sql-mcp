{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sql-mcp.local/semantic/view.schema.json",
  "title": "View",
  "description": "테이블 또는 view 를 묶는다. combine 은 from, join, union, minus, select 중 하나다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "name", "combine", "sources", "columns"],
  "properties": {
    "kind": { "const": "view" },
    "name": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" },
    "description": { "type": "string" },
    "combine": {
      "enum": ["from", "join", "union", "minus", "select"],
      "description": "from 은 테이블 하나. join, union, minus 는 테이블을 묶는다. select 는 view 를 묶어 요약 view 를 우선 고른다."
    },
    "prefer": {
      "const": "summary",
      "description": "select 전용. 사용자 SQL을 풀 수 있는 source 중 summary 를 우선한다."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "joins": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/join" }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/column" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "combine": { "const": "from" } },
        "required": ["combine"]
      },
      "then": {
        "properties": {
          "sources": {
            "maxItems": 1,
            "items": {
              "properties": { "kind": { "const": "table" } }
            }
          }
        },
        "not": {
          "anyOf": [
            { "required": ["joins"] },
            { "required": ["prefer"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "combine": { "const": "join" } },
        "required": ["combine"]
      },
      "then": {
        "required": ["joins"],
        "properties": {
          "sources": {
            "minItems": 2,
            "items": {
              "properties": { "kind": { "const": "table" } }
            }
          }
        },
        "not": { "required": ["prefer"] }
      }
    },
    {
      "if": {
        "properties": { "combine": { "enum": ["union", "minus"] } },
        "required": ["combine"]
      },
      "then": {
        "properties": {
          "sources": {
            "minItems": 2,
            "items": {
              "properties": { "kind": { "const": "table" } }
            }
          }
        },
        "not": {
          "anyOf": [
            { "required": ["joins"] },
            { "required": ["prefer"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "combine": { "const": "select" } },
        "required": ["combine"]
      },
      "then": {
        "required": ["prefer"],
        "properties": {
          "sources": {
            "minItems": 2,
            "contains": {
              "required": ["summary"],
              "properties": { "summary": { "const": true } }
            },
            "items": {
              "required": ["summary"],
              "properties": { "kind": { "const": "view" } }
            }
          }
        },
        "not": { "required": ["joins"] }
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "enum": ["table", "view"] },
        "name": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" },
        "summary": {
          "type": "boolean",
          "description": "select 전용. true 이면 요약 view."
        }
      }
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right", "type", "on"],
      "properties": {
        "left": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" },
        "right": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" },
        "type": { "enum": ["inner", "left", "right", "full"] },
        "on": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["left_column", "right_column"],
            "properties": {
              "left_column": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" },
              "right_column": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" }
            }
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mappings"],
      "properties": {
        "name": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "column"],
            "properties": {
              "source": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" },
              "column": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" }
            }
          }
        }
      }
    }
  }
}
