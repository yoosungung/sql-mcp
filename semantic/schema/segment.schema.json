{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sql-mcp.local/semantic/segment.schema.json",
  "title": "Segment",
  "description": "cube 에 연결되는 이름 있는 필터.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "name", "cube", "filter"],
  "properties": {
    "kind": { "const": "segment" },
    "name": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" },
    "description": { "type": "string" },
    "cube": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" },
    "filter": {
      "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/filter",
      "description": "시멘틱 컬럼 이름을 쓰는 조건식."
    }
  }
}
