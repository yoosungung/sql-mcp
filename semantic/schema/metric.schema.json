{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sql-mcp.local/semantic/metric.schema.json",
  "title": "Metric",
  "description": "cube 에 연결되는 지표. DW 에이전트에게는 그 cube 의 컬럼으로 보인다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "name", "cube", "expression", "aggregation", "filter"],
  "properties": {
    "kind": { "const": "metric" },
    "name": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" },
    "description": { "type": "string" },
    "cube": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" },
    "expression": {
      "type": "string",
      "minLength": 1,
      "description": "연결된 cube 의 view 컬럼 연산. 예: sum(sale_amount), sale_amount * fx_rate."
    },
    "aggregation": {
      "enum": ["group", "rollup", "cube", "grouping_sets"],
      "description": "그룹 기준에 대한 집계. group, rollup, cube, grouping_sets."
    },
    "group_by": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "aggregation이 group일 때 GROUP BY에 쓰는 view 컬럼.",
      "items": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/name" }
    },
    "filter": {
      "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/nullableFilter",
      "description": "이 지표에만 붙는 필터. 시멘틱 컬럼 이름을 쓴다. 없으면 null."
    },
    "role": { "$ref": "https://sql-mcp.local/semantic/common.schema.json#/$defs/role" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "aggregation": { "const": "group" } },
        "required": ["aggregation"]
      },
      "then": { "required": ["group_by"] }
    },
    {
      "if": {
        "properties": { "aggregation": { "enum": ["rollup", "cube", "grouping_sets"] } },
        "required": ["aggregation"]
      },
      "then": { "not": { "required": ["group_by"] } }
    }
  ]
}
