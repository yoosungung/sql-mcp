{
  "rust-analyzer.linkedProjects": ["Cargo.toml"],
  "rust-analyzer.cargo.features": "all",
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.cargo.extraEnv": {
    "SQL_MCP_SKIP_UI_BUILD": "1"
  },
  "lldb.cargo": "/Users/ericyoo/.cargo/bin/cargo",
  "lldb.adapterEnv": {
    "PATH": "${env:HOME}/.local/bin:${env:HOME}/.cargo/bin:/opt/homebrew/bin:${env:PATH}"
  },
  "terminal.integrated.env.osx": {
    "PATH": "${env:HOME}/.local/bin:${env:HOME}/.cargo/bin:/opt/homebrew/bin:${env:PATH}"
  },
  "files.watcherExclude": {
    "**/target/**": true,
    "**/data/**": true,
    "**/target_db/.cache/**": true
  }
}
