# 저장소 루트에서 source 한다. fetch_bird.sh 실행 후 사용.
# set -a && source ./client/bird/env.bird.example && set +a
# SQL_MCP_SEMANTIC_PATH 는 BIRD 카탈로그. 제품 기본값 ./data/semantic.db 와 분리한다.

_BIRD="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

export SQL_MCP_SEMANTIC_PATH="${_BIRD}/semantic.db"
export SQL_MCP_TARGET_SUPERHERO_URL="sqlite:${_BIRD}/superhero/superhero.sqlite?mode=ro"
export SQL_MCP_TARGET_STUDENT_CLUB_URL="sqlite:${_BIRD}/student_club/student_club.sqlite?mode=ro"
export SQL_MCP_TARGET_TOXICOLOGY_URL="sqlite:${_BIRD}/toxicology/toxicology.sqlite?mode=ro"
export SQL_MCP_TARGET_THROMBOSIS_URL="sqlite:${_BIRD}/thrombosis_prediction/thrombosis_prediction.sqlite?mode=ro"
export SQL_MCP_TARGET_CALIFORNIA_SCHOOLS_URL="sqlite:${_BIRD}/california_schools/california_schools.sqlite?mode=ro"
export SQL_MCP_TARGET_FORMULA_1_URL="sqlite:${_BIRD}/formula_1/formula_1.sqlite?mode=ro"
